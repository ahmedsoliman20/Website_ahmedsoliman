<main class="py-4">
  <div class="container px-4">
    <section id="model-viewer-section" class="mb-4" style="position: relative;">
      <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 100; color: white; font-size: 1.2rem; pointer-events: none; text-align: center;">
        <div style="font-weight: bold;">Hi, this is Ahmed Soliman</div>
        <div style="font-size: 0.9rem; margin-top: 8px; color: #ccc;">Computational Architect</div>
        <div style="font-size: 0.9rem; color: #ccc;">Structural Engineer</div>
      </div>
      <button class="learn-more-btn">Learn More</button>
      <model-viewer 
        src="export-for-the-site-3d-test.glb"
        alt="3D model"
        camera-controls
        touch-action="pan-y"
        style="width: 100%; height: 450px; border-radius: 12px; background: transparent;"
        interaction-prompt="auto"
        camera-orbit="45deg 80deg 70m"
        min-camera-orbit="-180deg 40deg 30m"
        max-camera-orbit="180deg 120deg 70m"
        field-of-view="45deg"
        exposure="1"
        shadow-intensity="0.25"
        camera-target="0m 37m 0m"
      ></model-viewer>
    </section>
    <div id="gallery-grid" style="column-count: 3; column-gap: 10px;"></div>
  </div>
</main>

<script>
  const projectCount = 10; 
  const grid = document.getElementById('gallery-grid');

  async function loadGallery() {
    const galleryItems = [];

    for (let i = 1; i <= projectCount; i++) {
      const folderPath = `../projects/project_${i}`;
      
      try {
        const response = await fetch(`${folderPath}/title.txt`);
        const titleText = response.ok ? await response.text() : `project ${i}`;

        galleryItems.push({
  title: titleText.trim(),
  img: `${folderPath}/cover.jpg`,
  // This constructs ../projects/project_1/project_1.html
  link: `${folderPath}/project_${i}.html` 
});
      } catch (error) {
        console.error(`Error loading project_${i}:`, error);
      }
    }

    galleryItems.sort(() => Math.random() - 0.5);

    grid.innerHTML = galleryItems.map((item, index) => `
      <div class="reveal-item d-inline-block w-100 mb-2" style="animation-delay: ${index * 0.15}s; break-inside: avoid;">
        <div class="tile" style="aspect-ratio: auto; height: auto;">
          <a class="img-link" href="${item.link}">
            <img src="${item.img}" class="img-fluid" alt="${item.title}" style="display: block; width: 100%;">
            <div class="tile-overlay"></div>
            <figcaption class="caption font-bebas">${item.title}</figcaption>
          </a>
        </div>
      </div>
    `).join('');
  }

  loadGallery();
</script>

<script>
  // Scroll effect for model viewer section
  window.addEventListener('scroll', () => {
    const modelSection = document.getElementById('model-viewer-section');
    const scrollPosition = window.scrollY;
    const modelHeight = modelSection.offsetHeight;
    
    // Calculate opacity: 1 at top, 0 after scrolling past model height
    const opacity = Math.max(0, 1 - (scrollPosition / (modelHeight * 0.6)));
    modelSection.style.opacity = opacity;
    
    // Optional: slight scale effect
    const scale = 1 - (scrollPosition / (modelHeight * 1.2)) * 0.05;
    modelSection.style.transform = `scale(${Math.max(0.95, scale)})`;

      // Rotate model down as you scroll
      const modelViewer = modelSection.querySelector('model-viewer');
      if (modelViewer) {
        // Initial values
        const azimuth = 45;
        const minElevation = 80; // starting elevation
        const maxElevation = 30; // end elevation (downward)
        // Clamp scroll between 0 and modelHeight
        const scrollClamped = Math.min(Math.max(scrollPosition, 0), modelHeight);
        // Interpolate elevation
        const elevation = minElevation - (minElevation - maxElevation) * (scrollClamped / modelHeight);
        // Keep radius as in HTML (70m)
        modelViewer.setAttribute('camera-orbit', `${azimuth}deg ${elevation}deg 70m`);
      }
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
